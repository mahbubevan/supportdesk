# Host user mapping (run: id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# Published ports (development)
NGINX_PORT=8080
PYTHON_PORT=8001
NODE_PORT=3000
MYSQL_PORT=3307

# MySQL (single source of truth for DB credentials)
DB_DATABASE=supportdesk
DB_USERNAME=supportdesk
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root


# Shared secret: Laravel -> Node internal events (openssl rand -hex 32)
NODE_INTERNAL_TOKEN=change-me-generate-with-openssl-rand-hex-32
